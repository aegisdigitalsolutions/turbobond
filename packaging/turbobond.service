[Unit]
Description=turbobond multi-WAN bonding gateway
Documentation=https://github.com/pop3crackle/turbobond
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/turbobond serve
Restart=always
RestartSec=3
# Routing, nftables, TUN and sysctl writes all need real privileges.
User=root
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN CAP_SYS_MODULE CAP_DAC_OVERRIDE
# One socket per uplink per session, plus the LAN's conntrack entries.
LimitNOFILE=131072
StateDirectory=turbobond
ConfigurationDirectory=turbobond
ConfigurationDirectoryMode=0750
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
