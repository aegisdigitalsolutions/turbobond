<resources>
    <string name="app_name">turbobond</string>
    <string name="subtitle">Bonds this phone\'s WiFi and mobile data across your own concentrator.</string>
    <string name="label_host">Concentrator host</string>
    <string name="hint_host">203.0.113.10</string>
    <string name="label_port">Concentrator port</string>
    <string name="default_port">5310</string>
    <string name="label_psk">Pre-shared key</string>
    <string name="hint_psk">the hex key the installer printed</string>
    <string name="label_profile">Connection profile</string>
    <string name="apply_profile">Apply profile</string>
    <string name="advanced_heading">Advanced settings</string>
    <string name="label_proxy_port">Proxy port (0 = off)</string>
    <string name="default_proxy_port">1080</string>
    <string name="label_dns_primary">DNS primary</string>
    <string name="default_dns_primary">1.1.1.1</string>
    <string name="label_dns_secondary">DNS secondary</string>
    <string name="default_dns_secondary">8.8.8.8</string>
    <string name="label_mtu">Tunnel MTU</string>
    <string name="default_mtu">1380</string>
    <string name="label_duplicate_under">Duplicate packets up to bytes</string>
    <string name="default_duplicate_under">260</string>
    <string name="label_pair_timeout">Handshake timeout (seconds)</string>
    <string name="default_pair_timeout">20</string>
    <string name="label_keepalive">Keepalive interval (seconds)</string>
    <string name="default_keepalive">15</string>
    <string name="label_silence_limit">Disconnect after silence (seconds)</string>
    <string name="default_silence_limit">75</string>
    <string name="diagnostics_heading">Live diagnostics</string>
    <string name="connect">Connect</string>
    <string name="disconnect">Disconnect</string>
    <string name="proxy_heading">SOCKS5 proxy for other devices</string>
    <string name="proxy_note">Turn on this phone\'s hotspot, connect another device to it, and point that device\'s proxy client (Surge, for example) at the address above. Its traffic then goes out over the bond.</string>
    <string name="tethering_note">Devices on this phone\'s hotspot are not bonded automatically: Android forwards tethered traffic in the kernel, outside the VPN. Sending them through the proxy above is what puts them on the bond. The proxy carries TCP; other traffic still goes out unbonded.</string>
</resources>
